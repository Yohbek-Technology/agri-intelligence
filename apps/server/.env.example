DATABASE_URL=postgresql://neondb_owner:npg_DV5EMwxm3HSy@ep-round-fire-b7ex0gvc-pooler.c-13.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# pnpx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend origin
CORS_ORIGIN=http://localhost:3000

# ── Socket.IO ─────────────────────────────────────────────────────────────────
SOCKET_CORS_ORIGIN=*

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Model IDs (defaults shown — override via env to switch models)
AI_DIAGNOSTICS_MODEL=gemini-3.8-flash
AI_DIAGNOSTICS_FALLBACK_MODEL=gemini-3.5-flash
AI_VOICE_MODEL=gemini-3.5-flash-lite
AI_VOICE_FALLBACK_MODEL=gemini-3.5-flash
AI_NARRATION_MODEL=gemini-3.5-flash
AI_NARRATION_FALLBACK_MODEL=gemini-3.8-flash
AI_ROTATION_MODEL=gemini-3.5-flash
AI_ROTATION_FALLBACK_MODEL=gemini-3.8-flash

# ── Text-to-Speech (TTS) ──────────────────────────────────────────────────────
AI_TTS_MODEL=gemini-3.8-flash-tts
AI_TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
AI_TTS_VOICE_AM=Achird
AI_TTS_VOICE_OM=Achird
AI_TTS_VOICE_TI=Achird
AI_TTS_VOICE_EN=Puck

# ── Speech-to-Text (STT) ───────────────────────────────────────────────────────
AI_STT_MODEL=gemini-3.5-transcribe
AI_STT_FALLBACK_MODEL=gemini-3.8-flash

# ── AI Provider (NODE_ENV=production → gemini, otherwise → openrouter) ────────
OPENROUTER_API_KEY=

# ── AfroMessage SMS Gateway (Ethiopia) ─────────────────────────────────────────
# Get your API token from https://afromessage.com dashboard
AFROMESSAGE_TOKEN=
# Optional: verified custom sender name (default: AfroMessage)
AFROMESSAGE_SENDER=
# Optional: system identifier ID if multiple short codes are configured
AFROMESSAGE_IDENTIFIER_ID=


# ── Test Database (Integration Tests) ──────────────────────────────────────────
# Used by CI/CD pipeline and local integration tests (does NOT touch production data)
TEST_DATABASE_URL=postgresql://neondb_owner:npg_13WZBhjPAxXw@ep-curly-cell-awlmsyah-pooler.c-12.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
