DATABASE_URL=
# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# pnpx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your frontend origin
CORS_ORIGIN=http://localhost:3000

# ── Socket.IO ─────────────────────────────────────────────────────────────────
SOCKET_CORS_ORIGIN=*

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Model IDs (defaults shown — override via env to switch models)
AI_DIAGNOSTICS_MODEL=gemini-3.8-flash
AI_DIAGNOSTICS_FALLBACK_MODEL=gemini-3.5-flash
AI_VOICE_MODEL=gemini-3.5-flash-lite
AI_VOICE_FALLBACK_MODEL=gemini-3.5-flash
AI_NARRATION_MODEL=gemini-3.5-flash
AI_NARRATION_FALLBACK_MODEL=gemini-3.8-flash
AI_ROTATION_MODEL=gemini-3.5-flash
AI_ROTATION_FALLBACK_MODEL=gemini-3.8-flash

# ── Text-to-Speech (TTS) ──────────────────────────────────────────────────────
AI_TTS_MODEL=gemini-3.8-flash-tts
AI_TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
AI_TTS_VOICE_AM=Achird
AI_TTS_VOICE_OM=Achird
AI_TTS_VOICE_TI=Achird
AI_TTS_VOICE_EN=Puck

# ── Speech-to-Text (STT) ───────────────────────────────────────────────────────
AI_STT_MODEL=gemini-3.5-transcribe
AI_STT_FALLBACK_MODEL=gemini-3.8-flash

# ── AI Provider (NODE_ENV=production → gemini, otherwise → openrouter) ────────
OPENROUTER_API_KEY=

# ── Africa's Talking SMS ──────────────────────────────────────────────────────
# Development — sandbox username is always 'sandbox' per AT docs
AT_SANDBOX_API_KEY=
# Production — live credentials
AT_USERNAME=
AT_API_KEY=
# Optional: registered alphanumeric sender ID (max 11 chars)
AT_SENDER_ID=
