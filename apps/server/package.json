{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx src/db/seed.ts",
    "open-auth-docs": "open-cli http://localhost:5000/api/auth/reference"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@google/genai": "^2.27.0",
    "@hono/node-server": "^2.1.3",
    "@repo/shared": "workspace:*",
    "africastalking": "^0.8.3",
    "better-auth": "^1.7.7",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "open-cli": "^9.0.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}