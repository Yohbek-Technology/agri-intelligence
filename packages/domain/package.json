{
  "name": "@repo/domain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mobile": "vitest run ../../apps/mobile/__tests__"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
